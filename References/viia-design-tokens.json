{
  "$schema": "viia-design-tokens",
  "source": "src/styles/global.css + inventaire réel des composants (viia.pro, août 2026)",
  "legend": {
    "existing": "valeur littéralement présente dans le code du site vitrine",
    "derived": "valeur du site, rangée dans une échelle nommée pour usage dashboard",
    "proposed": "n'existe pas encore — aucun form/statut/carte dans le repo actuel, à valider"
  },
  "color": {
    "brand": {
      "accent": { "value": "#EBED38", "status": "existing", "usage": "seul accent du site : CTA, liens actifs, highlights, pastille live" },
      "charcoal": { "value": "#444A4D", "status": "existing", "usage": "texte principal sur fond clair" },
      "black": { "value": "#17181A", "status": "existing", "usage": "fond des sections sombres" },
      "white": { "value": "#FFFFFF", "status": "existing" },
      "offwhite": { "value": "#F3F3F0", "status": "existing", "usage": "fond par défaut" }
    },
    "line": {
      "onLight": { "value": "rgba(68,74,77,0.16)", "status": "existing" },
      "onDark": { "value": "rgba(255,255,255,0.14)", "status": "existing" }
    },
    "trace": {
      "primary": { "value": "#EBED38", "status": "proposed", "note": "réutilise l'accent — aucune couleur de carte n'existe aujourd'hui, à valider sur fond satellite réel avant de figer" },
      "outline": { "value": "#17181A", "status": "proposed", "note": "liseré de contraste si le jaune seul se noie sur la carte, préférable à une 2e nuance de jaune" }
    },
    "semantic": {
      "success": { "value": "#4C7A5E", "bg": "#E9F1EC", "status": "proposed" },
      "warning": { "value": "#B4862B", "bg": "#F5EEDC", "status": "proposed" },
      "critical": { "value": "#B24B3C", "bg": "#F5E7E3", "status": "proposed" },
      "neutral": { "value": "#444A4D", "bg": "rgba(68,74,77,0.16)", "status": "proposed" }
    }
  },
  "typography": {
    "fontFamily": {
      "mono": { "value": "'Space Mono', ui-monospace, SFMono-Regular, Menlo, monospace", "status": "existing", "note": "unique famille sur tout le site, aucune police secondaire" }
    },
    "fontSize": {
      "2xs": { "value": "0.68rem", "status": "existing" },
      "xs": { "value": "0.72rem", "status": "existing", "note": "data-label par défaut" },
      "sm": { "value": "0.85rem", "status": "existing", "note": "link-arrow, texte dense" },
      "base": { "value": "1rem", "status": "existing", "note": "corps de texte par défaut" },
      "md": { "value": "1.05rem", "status": "existing", "note": "paragraphes lead" },
      "lg": { "value": "1.2rem", "status": "existing", "note": "citations, valeurs de carte" },
      "xl": { "value": "1.6rem", "status": "existing" },
