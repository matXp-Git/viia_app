      "displayLg": { "value": "clamp(2.2rem, 4vw, 3.2rem)", "status": "derived", "note": "h1 — moyenne des variantes hero observées" }
    },
    "lineHeight": {
      "tight": { "value": 1.15, "status": "existing" },
      "snug": { "value": 1.4, "status": "derived" },
      "normal": { "value": 1.6, "status": "existing" }
    },
    "fontWeight": {
      "regular": { "value": 400, "status": "existing", "note": "RÈGLE DE MAISON : tous les titres sont en 400, jamais 700" },
      "bold": { "value": 700, "status": "existing", "note": "réservé aux valeurs de données et emphases inline" }
    },
    "letterSpacing": {
      "label": { "value": "0.06em", "status": "existing" },
      "eyebrow": { "value": "0.08em", "status": "existing" }
    }
  },
  "space": {
    "1": { "value": "4px", "status": "derived" },
    "2": { "value": "8px", "status": "existing", "note": "gap le plus fréquent du site (x13)" },
    "3": { "value": "12px", "status": "existing" },
    "4": { "value": "16px", "status": "existing" },
    "5": { "value": "20px", "status": "existing" },
    "6": { "value": "24px", "status": "existing", "note": "2e gap le plus fréquent (x7)" },
    "7": { "value": "32px", "status": "existing" },
    "8": { "value": "48px", "status": "existing" },
    "9": { "value": "64px", "status": "existing" },
    "10": { "value": "88px", "status": "existing" },
    "gutter": { "value": "clamp(20px, 4vw, 64px)", "status": "existing" },
    "containerMax": { "value": "1280px", "status": "existing" }
  },
  "radius": {
    "none": { "value": "0", "status": "existing", "note": "défaut — le site est volontairement anguleux" },
    "sm": { "value": "4px", "status": "existing", "note": "inputs, textarea" },
    "full": { "value": "999px", "status": "existing", "note": "boutons pilule, status-pill" },
    "circle": { "value": "50%", "status": "existing", "note": "pastilles de statut, avatars" }
  },
  "motion": {
    "durationFast": { "value": "0.15s", "status": "existing" },
    "easeStandard": { "value": "ease", "status": "existing" }
  },
  "focus": {
    "ring": { "value": "0 0 0 3px color-mix(in srgb, #EBED38 45%, transparent)", "status": "proposed", "note": "le site actuel n'a quasi aucun focus-ring visible (juste un changement de bordure) — insuffisant pour un dashboard clavier" }
  },
  "breakpoint": {
    "tablet": { "value": "900px", "status": "existing", "note": "bascule principale (x10 occurrences)" },
    "mobile": { "value": "600px", "status": "existing" }
  }
}
