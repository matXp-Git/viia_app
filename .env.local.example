# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# MapLibre tile style. Default: OpenFreeMap dark style (free, no key/quota).
# Swap to a MapTiler style URL (with key) if the OpenFreeMap render doesn't
# hold up visually — the app never hardcodes a provider, only this var.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Order e-mails (Resend). Optional: without these, orders still work and the
# e-mail step is simply skipped. Set them in Vercel → Settings → Environment
# Variables (never commit real values).
# RESEND_API_KEY=            API key from resend.com (needs a verified sending domain)
# ORDER_EMAIL_FROM=          e.g. "ViiA <commandes@viia.pro>" — must be on the verified domain
# ORDER_NOTIFY_EMAIL=order@viia.pro   ViiA's inbox for new orders (this is the default)
